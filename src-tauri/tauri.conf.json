{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rift Coach",
  "version": "0.1.0",
  "identifier": "com.riftcoach.app",
  "build": {
    "beforeDevCommand": "npm run ui:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run ui:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Rift Coach",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Rift Coach",
    "copyright": "Rift Coach contributors",
    "category": "Game",
    "shortDescription": "Local League of Legends performance coach",
    "longDescription": "Tracks your League of Legends games on your PC and explains why you win or lose: metrics, patterns, higher-rank benchmarks, and AI reviews grounded in your match data.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU1RUI2ODNFOUZEQUQyMTIKUldRUzB0cWZQbWpyNWVPL3haSitCTFdraVJBRkZDMUdmZHBMbklRaFc0SnpXR1pHalRFczk2Q2cK",
      "endpoints": [
        "https://github.com/tmaiorca/rift-coach/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
